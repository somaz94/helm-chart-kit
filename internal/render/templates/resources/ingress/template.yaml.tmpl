{{- if .Values.ingress.enabled -}}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ include "[[ .ChartName ]].fullname" . }}
  labels:
    {{- include "[[ .ChartName ]].labels" . | nindent 4 }}
  {{- /* The GKE resources are wired here rather than left to be remembered:
         both are referenced by name from an annotation, and an annotation
         naming nothing is the failure the whole pair exists to avoid. The
         access is parenthesised because neither may be in the chart. */}}
  {{- $gke := dict }}
  {{- if (.Values.managedCertificate).enabled }}
  {{- $_ := set $gke "networking.gke.io/managed-certificates" (include "[[ .ChartName ]].fullname" .) }}
  {{- end }}
  {{- if (.Values.frontendConfig).enabled }}
  {{- $_ := set $gke "networking.gke.io/v1beta1.FrontendConfig" (include "[[ .ChartName ]].fullname" .) }}
  {{- end }}
  {{- $annotations := merge (dict) $gke .Values.ingress.annotations }}
  {{- with $annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  {{- with .Values.ingress.className }}
  ingressClassName: {{ . }}
  {{- end }}
  {{- with .Values.ingress.tls }}
  tls:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  rules:
    {{- range .Values.ingress.hosts }}
    - host: {{ .host | quote }}
      http:
        paths:
          {{- range .paths }}
          - path: {{ .path }}
            pathType: {{ .pathType }}
            backend:
              service:
                name: {{ include "[[ .ChartName ]].fullname" $ }}
                port:
                  number: {{ $.Values.service.port }}
          {{- end }}
    {{- end }}
{{- end }}
