# -- A fixed fleet has no zones to spread over, so spread over nodes instead.
topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: kubernetes.io/hostname
    whenUnsatisfiable: ScheduleAnyway
    # matchLabelKeys rather than a literal selector: the pod labels come
    # from nameOverride and the release name, so a baked-in name selects
    # nothing the moment a consumer overrides it.
    matchLabelKeys:
      - app.kubernetes.io/name
      - app.kubernetes.io/instance

# -- Private registry credentials. On a self-managed cluster there is no
# ambient identity granting registry access the way a cloud node role does.
imagePullSecrets:
  - name: registry-credentials
