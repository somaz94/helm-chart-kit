# =============================================================================
# Workload
# =============================================================================

# -- Number of pod replicas. Ignored when autoscaling.enabled is true.
replicaCount: 1

# -- ReplicaSets kept for rollback
revisionHistoryLimit: 3

# -- Rollout strategy
updateStrategy:
  type: RollingUpdate
  rollingUpdate:
    maxSurge: 25%
    maxUnavailable: 0

# -- Seconds a pod gets to shut down before SIGKILL
terminationGracePeriodSeconds: 30

# -- PriorityClass for the pods
priorityClassName: ""

# =============================================================================
# Container Image
# =============================================================================
image:
  # -- Image repository, without the tag
  repository: nginx
  # -- Image pull policy
  pullPolicy: IfNotPresent
  # -- Image tag. Required — the render fails when it is empty, on purpose:
  # falling back to appVersion is how a stale image reaches production.
  tag: ""

# -- Secrets used to pull from a private registry
imagePullSecrets: []

# -- Port the container listens on
containerPort: 8080

# -- Override the image entrypoint
command: []

# -- Override the image arguments
args: []

# -- Environment variables, in Kubernetes list form
env: []

# -- ConfigMap and Secret references mounted as environment
envFrom: []

# =============================================================================
# Pod Metadata
# =============================================================================

# -- Annotations added to pods
podAnnotations: {}

# -- Labels added to pods, on top of the selector labels
podLabels: {}

# =============================================================================
# Security Context
#
# The defaults below are the restricted Pod Security Standard. Loosen them
# deliberately rather than starting permissive.
# =============================================================================
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 65534
  runAsGroup: 65534
  fsGroup: 65534
  seccompProfile:
    type: RuntimeDefault

securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop:
      - ALL

# =============================================================================
# Probes
# =============================================================================
livenessProbe:
  httpGet:
    path: /healthz
    port: http
  initialDelaySeconds: 10
  periodSeconds: 10

readinessProbe:
  httpGet:
    path: /readyz
    port: http
  initialDelaySeconds: 5
  periodSeconds: 5

# -- Startup probe. Set this for slow-booting workloads so the liveness probe
# does not kill the pod before it has finished starting.
startupProbe: {}

# =============================================================================
# Resources
#
# A CPU limit is deliberately absent: CFS throttling on a limit causes latency
# spikes long before the node is under pressure. Memory is limited because it
# is incompressible.
# =============================================================================
resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    memory: 256Mi

# =============================================================================
# Scheduling
# =============================================================================

# -- Node labels the pods must match
nodeSelector: {}

# -- Affinity rules
affinity: {}

# -- Tolerations
tolerations: []

# -- Spread pods across zones or nodes
topologySpreadConstraints: []

# =============================================================================
# Storage
# =============================================================================

# -- Volumes added to the pod
volumes: []

# -- Volume mounts added to the container
volumeMounts: []
