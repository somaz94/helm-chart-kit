# -- Three, so losing one leaves a majority and a rolling update never drops
# below two.
replicaCount: 3

# -- Enough history to roll back past a bad release and the one before it.
revisionHistoryLimit: 10

# -- maxUnavailable: 0 keeps full capacity through a rollout; maxSurge: 1
# limits the extra cost to one pod rather than a whole second copy.
updateStrategy:
  type: RollingUpdate
  rollingUpdate:
    maxSurge: 1
    maxUnavailable: 0

# -- Long enough to finish in-flight requests and deregister from the load
# balancer. Too short here is the usual cause of 502s during a deploy.
terminationGracePeriodSeconds: 60

resources:
  requests:
    cpu: 500m
    memory: 512Mi
  limits:
    memory: 1Gi

# -- Slow to declare death, quick to declare readiness. A liveness probe that
# fires under load turns a busy service into a restarting one.
livenessProbe:
  httpGet:
    path: /healthz
    port: http
  initialDelaySeconds: 15
  periodSeconds: 20
  timeoutSeconds: 5
  failureThreshold: 6

readinessProbe:
  httpGet:
    path: /readyz
    port: http
  initialDelaySeconds: 5
  periodSeconds: 5
  timeoutSeconds: 3
  failureThreshold: 3

# -- Give a slow starter room to boot without the liveness probe killing it.
startupProbe:
  httpGet:
    path: /healthz
    port: http
  periodSeconds: 5
  failureThreshold: 30
