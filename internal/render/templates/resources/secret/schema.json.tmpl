{
  "secret": {
    "type": "object",
    "description": "Opaque Secret. Anything set here ends up in the Helm release, which is itself a Secret readable by anyone who can read release history — use externalSecret or a SealedSecret for anything that must survive in git.",
    "properties": {
      "enabled": {
        "type": "boolean",
        "description": "Create the Secret"
      },
      "type": {
        "type": "string",
        "description": "Secret type"
      },
      "stringData": {
        "type": "object",
        "description": "Key to value. Left empty on purpose — never commit a real credential.",
        "additionalProperties": { "type": "string" }
      }
    }
  }
}
