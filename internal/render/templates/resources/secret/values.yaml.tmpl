# =============================================================================
# Secret
#
# Anything set here ends up in the Helm release, which is itself a Secret in
# the cluster and is readable by anyone who can read release history. Use this
# only for values supplied at install time (--set, an ArgoCD parameter, a CI
# variable). For anything that must survive in git, use `hck add externalsecret`
# or a SealedSecret instead.
# =============================================================================
secret:
  # -- Create the Secret
  enabled: false
  # -- Secret type
  type: Opaque
  # -- Key to value. Left empty on purpose — never commit a real credential.
  stringData: {}
