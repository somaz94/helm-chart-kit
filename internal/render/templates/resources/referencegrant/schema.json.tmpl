{
  "referenceGrant": {
    "type": "object",
    "description": "Gateway API ReferenceGrant. Cross-namespace references are refused by default; the grant lives with the target namespace, which is what makes it a decision rather than a claim.",
    "properties": {
      "enabled": {
        "type": "boolean",
        "description": "Create the ReferenceGrant"
      },
      "from": {
        "type": "array",
        "description": "Namespaces and kinds allowed to reference this chart's Service",
        "items": {
          "type": "object",
          "required": ["kind", "namespace"],
          "properties": {
            "group": { "type": "string" },
            "kind": { "type": "string" },
            "namespace": { "type": "string" }
          }
        }
      }
    }
  }
}
