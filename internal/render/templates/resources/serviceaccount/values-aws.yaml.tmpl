serviceAccount:
  annotations:
    # -- IAM role the pods assume, via IRSA. EKS Pod Identity does not use this
    # annotation at all — it binds through a PodIdentityAssociation. The role's
    # trust policy has to name this namespace and service account, or the pod
    # gets credentials for nothing.
    eks.amazonaws.com/role-arn: arn:aws:iam::000000000000:role/[[ .ChartName ]]
