apiVersion: v1
kind: Service
metadata:
  name: {{ include "[[ .ChartName ]].fullname" . }}
  labels:
    {{- include "[[ .ChartName ]].labels" . | nindent 4 }}
  {{- /* Wired here for the same reason as the Ingress annotations: GKE reads
         the BackendConfig off the Service by name, and a name nothing
         provides makes GCLB fall back to a health check on "/". */}}
  {{- $gke := dict }}
  {{- if (.Values.backendConfig).enabled }}
  {{- $ref := dict "default" (include "[[ .ChartName ]].fullname" .) }}
  {{- $_ := set $gke "cloud.google.com/backend-config" (toJson $ref) }}
  {{- end }}
  {{- $annotations := merge (dict) $gke .Values.service.annotations }}
  {{- with $annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  type: {{ .Values.service.type }}
  {{- if .Values.service.headless }}
  clusterIP: None
  {{- end }}
  ports:
    - name: {{ .Values.service.portName }}
      port: {{ .Values.service.port }}
      targetPort: {{ .Values.service.targetPort }}
      protocol: TCP
      {{- if and (eq .Values.service.type "NodePort") .Values.service.nodePort }}
      nodePort: {{ .Values.service.nodePort }}
      {{- end }}
    {{- with .Values.service.extraPorts }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
  selector:
    {{- include "[[ .ChartName ]].selectorLabels" . | nindent 4 }}
