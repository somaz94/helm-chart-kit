persistence:
  # -- gp3 rather than gp2: same durability, cheaper, and IOPS and throughput
  # are set independently of size. Unlike GKE and AKS, EKS ships no gp3 class —
  # create one against the EBS CSI driver, or the claim stays Pending.
  storageClass: gp3

# -- EBS volumes are zonal, so a rescheduled pod has to land in the zone its
# volume is in. The CSI driver handles that through the storage class's
# WaitForFirstConsumer binding; this keeps replicas spread while it does.
topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: topology.kubernetes.io/zone
    whenUnsatisfiable: ScheduleAnyway
    # matchLabelKeys rather than a literal selector: the pod labels come
    # from nameOverride and the release name, so a baked-in name selects
    # nothing the moment a consumer overrides it.
    matchLabelKeys:
      - app.kubernetes.io/name
      - app.kubernetes.io/instance
