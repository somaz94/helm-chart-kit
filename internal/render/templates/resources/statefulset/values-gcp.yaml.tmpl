persistence:
  # -- Balanced persistent disk: SSD-backed, and the sensible default unless
  # the workload is measurably IOPS-bound.
  storageClass: premium-rwo

# -- Persistent disks are zonal, so a rescheduled pod has to return to its
# volume's zone. Spread replicas so a zone loss takes one of them, not all.
topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: topology.kubernetes.io/zone
    whenUnsatisfiable: ScheduleAnyway
    # matchLabelKeys rather than a literal selector: the pod labels come
    # from nameOverride and the release name, so a baked-in name selects
    # nothing the moment a consumer overrides it.
    matchLabelKeys:
      - app.kubernetes.io/name
      - app.kubernetes.io/instance
