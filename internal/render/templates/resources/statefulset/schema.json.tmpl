{
  "replicaCount": {
    "type": "integer",
    "minimum": 0,
    "description": "Number of replicas"
  },
  "podManagementPolicy": {
    "type": "string",
    "enum": ["OrderedReady", "Parallel"],
    "description": "Parallel starts every pod at once; OrderedReady waits for each to become ready before starting the next."
  },
  "updateStrategy": {
    "type": "object",
    "description": "Rollout strategy",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["RollingUpdate", "OnDelete"]
      },
      "rollingUpdate": {
        "type": "object"
      }
    }
  },
  "terminationGracePeriodSeconds": {
    "type": "integer",
    "minimum": 0,
    "description": "Seconds a pod gets to shut down before SIGKILL. Raise it for a database that must flush on the way out."
  },
  "image": {
    "type": "object",
    "description": "Container image",
    "required": ["repository", "tag"],
    "properties": {
      "repository": {
        "type": "string",
        "minLength": 1,
        "description": "Image repository, without the tag"
      },
      "pullPolicy": {
        "type": "string",
        "enum": ["Always", "IfNotPresent", "Never"],
        "description": "Image pull policy"
      },
      "tag": {
        "type": "string",
        "description": "Image tag. Required at render time — _helpers.tpl calls fail when it is empty."
      }
    }
  },
  "imagePullSecrets": {
    "type": "array",
    "description": "Secrets used to pull from a private registry"
  },
  "containerPort": {
    "type": "integer",
    "minimum": 1,
    "maximum": 65535,
    "description": "Port the container listens on"
  },
  "env": {
    "type": "array",
    "description": "Environment variables, in Kubernetes list form"
  },
  "podAnnotations": {
    "type": "object",
    "description": "Annotations added to pods"
  },
  "podLabels": {
    "type": "object",
    "description": "Labels added to pods, on top of the selector labels"
  },
  "podSecurityContext": {
    "type": "object",
    "description": "Pod-level security context. Defaults to the restricted Pod Security Standard."
  },
  "securityContext": {
    "type": "object",
    "description": "Container-level security context"
  },
  "livenessProbe": {
    "type": "object",
    "description": "Liveness probe"
  },
  "readinessProbe": {
    "type": "object",
    "description": "Readiness probe"
  },
  "resources": {
    "type": "object",
    "description": "Compute resources"
  },
  "nodeSelector": {
    "type": "object",
    "description": "Node labels the pods must match"
  },
  "affinity": {
    "type": "object",
    "description": "Affinity rules"
  },
  "tolerations": {
    "type": "array",
    "description": "Tolerations"
  },
  "volumes": {
    "type": "array",
    "description": "Volumes added to the pod"
  },
  "volumeMounts": {
    "type": "array",
    "description": "Volume mounts added to the container"
  },
  "persistence": {
    "type": "object",
    "description": "Rendered as volumeClaimTemplates, so every replica gets its own volume.",
    "properties": {
      "enabled": {
        "type": "boolean",
        "description": "Attach a per-replica volume"
      },
      "mountPath": {
        "type": "string",
        "description": "Where the volume is mounted in the container"
      },
      "storageClass": {
        "type": "string",
        "description": "StorageClass. Empty uses the cluster default."
      },
      "accessModes": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
        }
      },
      "size": {
        "type": "string",
        "description": "Requested size, as a Kubernetes quantity"
      }
    }
  }
}
