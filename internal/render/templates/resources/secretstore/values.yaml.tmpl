# =============================================================================
# SecretStore
#
# The namespaced kind, not ClusterSecretStore. A ClusterSecretStore is one
# object for the whole cluster and belongs to whoever runs the cluster; a chart
# creating one would collide with the next release that did the same.
#
# This is the store for a chart that owns its own credentials path. Where the
# cluster already provides a shared store, leave this off and point
# externalSecret.secretStoreRef at that one — which is the default.
#
# Nothing wires the two together automatically: externalSecret.secretStoreRef
# has a meaningful default, and silently repointing it would change what an
# existing chart reads from. Turn this on and set the ref yourself; HCK039
# reports the pair left unwired.
# =============================================================================
secretStore:
  # -- Create the SecretStore
  enabled: false
  # -- How the operator backs off when the provider is unreachable.
  retrySettings:
    maxRetries: 5
    retryInterval: 10s
  # -- Provider block, verbatim. The shape is the provider's own and hck does
  # not constrain it — an incomplete schema here would reject a provider ESO
  # supports. The platform overlays fill this in for a cloud.
  provider: {}
